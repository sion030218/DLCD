  <vhdl name="andor">library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

entity andor is
    port(
        a, b, c, d : in std_logic;
        out1, out2 : out std_logic
    );
end entity andor;

architecture bhv of andor is
begin
    out1 &lt;= a and b and c and d;
    out2 &lt;= a or b or c or d;
end architecture bhv;</vhdl>
  <vhdl name="mux8_1">library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

entity mux8_1 is
    port(
        a, b, c, d, e, f, g, h : in std_logic;
        ch : in std_logic_vector(2 downto 0);
        data : out std_logic
    );
end entity mux8_1;

architecture bhv of mux8_1 is
begin
    process(a, b, c, d, e, f, g, h, ch)
    begin
        case ch is
            when "000" =&gt; data &lt;= a;
            when "001" =&gt; data &lt;= b;
            when "010" =&gt; data &lt;= c;
            when "011" =&gt; data &lt;= d;
            when "100" =&gt; data &lt;= e;
            when "101" =&gt; data &lt;= f;
            when "110" =&gt; data &lt;= g;
            when "111" =&gt; data &lt;= h;
            when others =&gt; data &lt;= '0';
        end case;
    end process;
end architecture bhv;</vhdl>
  <vhdl name="led">library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

entity led is
    port(
        en      : in std_logic;
        dat     : in std_logic_vector(3 downto 0);
        display : out std_logic_vector(7 downto 0)
    );
end entity led;

architecture bhv of led is
begin
    process(en, dat)
    begin
        if en = '0' then
            display &lt;= "ZZZZZZZZ";
        else
            case dat is
                when "0000" =&gt; display &lt;= "11111010"; -- a
                when "0001" =&gt; display &lt;= "00111110"; -- b
                when "0010" =&gt; display &lt;= "00011010"; -- c
                when "0011" =&gt; display &lt;= "01111010"; -- d
                when "0100" =&gt; display &lt;= "10001110"; -- f
                when "0101" =&gt; display &lt;= "11110110"; -- g
                when others =&gt; display &lt;= "00000000";
            end case;
        end if;
    end process;
end architecture bhv;</vhdl>
  <vhdl name="vote25">library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

entity vote25 is
    port(
        vt     : in std_logic_vector(24 downto 0);
        result : out std_logic
    );
end entity vote25;

architecture bhv of vote25 is
begin
    process(vt)
        variable sum : integer range 0 to 25;
    begin
        sum := 0;

        for i in 0 to 24 loop
            if vt(i) = '1' then
                sum := sum + 1;
            end if;
        end loop;

        if sum &gt;= 13 then
            result &lt;= '1';
        else
            result &lt;= '0';
        end if;
    end process;
end architecture bhv;</vhdl>
  <vhdl name="count13">library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

entity count13 is
    port(
        vt      : in std_logic_vector(12 downto 0);
        en      : in std_logic;
        display : out std_logic_vector(7 downto 0)
    );
end entity count13;

architecture bhv of count13 is
begin
    process(vt, en)
        variable sum : integer range 0 to 15;
    begin
        sum := 0;

        for i in 0 to 12 loop
            if vt(i) = '1' then
                sum := sum + 1;
            end if;
        end loop;

        if en = '0' then
            display &lt;= "ZZZZZZZZ";

        else
            case sum is
                when 0  =&gt; display &lt;= "11111100";
                when 1  =&gt; display &lt;= "01100000";
                when 2  =&gt; display &lt;= "11011010";
                when 3  =&gt; display &lt;= "11110010";
                when 4  =&gt; display &lt;= "01100110";
                when 5  =&gt; display &lt;= "10110110";
                when 6  =&gt; display &lt;= "10111110";
                when 7  =&gt; display &lt;= "11100000";
                when 8  =&gt; display &lt;= "11111110";
                when 9  =&gt; display &lt;= "11100110";

                when 10 =&gt; display &lt;= "11101110"; -- A
                when 11 =&gt; display &lt;= "00111110"; -- b
                when 12 =&gt; display &lt;= "10011100"; -- C
                when 13 =&gt; display &lt;= "01111010"; -- d
                when 14 =&gt; display &lt;= "10011110"; -- E
                when 15 =&gt; display &lt;= "10001110"; -- F

                when others =&gt;
                    display &lt;= "00000000";
            end case;
        end if;

    end process;
end architecture bhv;</vhdl>
